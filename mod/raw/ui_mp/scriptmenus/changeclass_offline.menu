// Choose Class (offline games): the ten preset classes and the highlighted one's loadout, laid out
// like the online menu. Responses and the loadout table are the stock ones
// (raw/ui_mp/scriptmenus/changeclass_offline.menu in the mod tools).

#include "ui_mp/unlimited.inc"

#define SHOW_CLASS( offset )	execnow "set ui_class_offset "offset;

#define SLOT( field )	tablelookup( "mp/offline_classTable.csv", 1, (dvarInt("ui_class_offset")+field), 5 )

#define STAT_CAC_PRIMARY				SLOT( 1 )
#define STAT_CAC_PRIMARY_ATTACHMENT		SLOT( 2 )
#define STAT_CAC_SECONDARY				SLOT( 3 )
#define STAT_CAC_SECONDARY_ATTACHMENT	SLOT( 4 )
#define STAT_CAC_SPECIALTY_EQUIPMENT	SLOT( 5 )
#define STAT_CAC_SPECIALTY_WEAPON		SLOT( 6 )
#define STAT_CAC_SPECIALTY_ABILITY		SLOT( 7 )
#define STAT_CAC_SPECIAL_GRENADE		SLOT( 8 )

#define OFFLINE_CLASS( button, edge, y, label, response, offset ) \
	LIST_BUTTON( button, edge, y, text label, scriptMenuResponse response; close self;, SHOW_CLASS( offset ), 1 )

{
	menuDef
	{
		name			"changeclass_offline"
		rect			0 0 640 480
		focuscolor		.94 .98 .91 1
		style			0
		blurWorld		7.0
		onOpen
		{
			SHOW_CLASS( "200" )
			focusFirst;
			BUTTON_FOCUS( class_1, edge_1 )
		}
		onEsc
		{
			close self;
			uiScript openHomeMenu;
		}

		PAGE( "COD UNLIMITED  /  MATCH", text "CHOOSE CLASS", exp text( MAP_NAME ); )

		SECTION( 110, "CLASSES" )
		OFFLINE_CLASS( class_1, edge_1, 126, "@CLASS_OFFLINE_CLASS1", "offline_class1_mp,0", "200" )
		OFFLINE_CLASS( class_2, edge_2, 152, "@CLASS_OFFLINE_CLASS2", "offline_class2_mp,0", "210" )
		OFFLINE_CLASS( class_3, edge_3, 178, "@CLASS_OFFLINE_CLASS3", "offline_class3_mp,0", "220" )
		OFFLINE_CLASS( class_4, edge_4, 204, "@CLASS_OFFLINE_CLASS4", "offline_class4_mp,0", "230" )
		OFFLINE_CLASS( class_5, edge_5, 230, "@CLASS_OFFLINE_CLASS5", "offline_class5_mp,0", "240" )
		OFFLINE_CLASS( class_6, edge_6, 256, "@CLASS_OFFLINE_CLASS6", "offline_class6_mp,0", "250" )
		OFFLINE_CLASS( class_7, edge_7, 282, "@CLASS_OFFLINE_CLASS7", "offline_class7_mp,0", "260" )
		OFFLINE_CLASS( class_8, edge_8, 308, "@CLASS_OFFLINE_CLASS8", "offline_class8_mp,0", "270" )
		OFFLINE_CLASS( class_9, edge_9, 334, "@CLASS_OFFLINE_CLASS9", "offline_class9_mp,0", "280" )
		OFFLINE_CLASS( class_10, edge_10, 360, "@CLASS_OFFLINE_CLASS10", "offline_class10_mp,0", "290" )

		BUTTON( button_back, edge_back, 418, "BACK", close self; uiScript openHomeMenu;, 1 )

		#include "ui_mp/unlimited_loadout.inc"
		FOOTER( "ESC   BACK" )
	}
}
